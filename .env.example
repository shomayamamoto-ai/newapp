# ---- Core ----
SNSAUTO_DB_URL=sqlite:///workspace/snsauto.db
SNSAUTO_WORKSPACE=workspace

# ---- LLM (script / storyboard / analysis) ----
ANTHROPIC_API_KEY=
SNSAUTO_LLM_MODEL=claude-opus-5

# ---- YouTube Data API v3 ----
# Research (search/statistics) needs only an API key.
YOUTUBE_API_KEY=
# Upload needs OAuth2 (user consent, youtube.upload scope).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- X (Twitter) API v2 ----
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- Instagram Graph API (Business/Creator account via Facebook app) ----
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- TikTok Content Posting API ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- Image generation (optional; provider-agnostic HTTP endpoint) ----
IMAGEGEN_PROVIDER=placeholder
IMAGEGEN_API_KEY=
IMAGEGEN_ENDPOINT=

# ---- Visual mode: still | animate | footage | auto ----
SNSAUTO_VISUAL_MODE=still

# ---- Image -> video generation (each shot actually moves) ----
# Generic async job API: POST endpoint -> {id}, then poll status endpoint.
VIDEOGEN_PROVIDER=none
VIDEOGEN_API_KEY=
VIDEOGEN_ENDPOINT=
VIDEOGEN_STATUS_ENDPOINT=
VIDEOGEN_POLL_SECONDS=6
VIDEOGEN_TIMEOUT_SECONDS=900

# ---- Real / stock footage ----
SNSAUTO_FOOTAGE_DIR=
STOCK_PROVIDER=none
STOCK_API_KEY=
STOCK_ENDPOINT=

# ---- Narration (TTS) ----
TTS_PROVIDER=none
TTS_API_KEY=
TTS_ENDPOINT=
TTS_VOICE=
TTS_SPEED=1.0
TTS_CHARS_PER_SEC=7.0

# ---- Web auth (REQUIRED when the UI is not on localhost) ----
SNSAUTO_AUTH_ENABLED=false
SNSAUTO_SECRET_KEY=
SNSAUTO_SESSION_HOURS=12
SNSAUTO_COOKIE_SECURE=true

# ---- Worker ----
SNSAUTO_WORKER_INTERVAL=60

# ---- Public asset hosting (REQUIRED for Instagram publishing) ----
# s3 | local | none
STORAGE_BACKEND=none
# Where this app is reachable from the public internet. Required for
# STORAGE_BACKEND=local, because Meta fetches the video from its own servers.
SNSAUTO_PUBLIC_BASE_URL=

# S3-compatible: AWS S3, Cloudflare R2, MinIO, Wasabi ...
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Set when the bucket is public or behind a CDN; links are then permanent.
# Leave blank for a private bucket and presigned (expiring) URLs.
S3_PUBLIC_BASE_URL=
S3_EXPIRES_IN=21600

# ---- Failure notifications ----
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- Instagram publishing goes through a Facebook app ----
# Required to connect an Instagram account from the UI. The Instagram account
# must be a Business/Creator account connected to a Facebook Page.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Refresh tokens this many hours before they expire (TikTok's last 24h).
SNSAUTO_TOKEN_REFRESH_MARGIN=6

# ---- App credentials for account connection (OAuth) ----
# These identify *your app* to each platform. Per-account tokens are obtained
# through the UI at /accounts and stored in the database, where the worker can
# refresh them.
#   YouTube : Google Cloud console -> OAuth client (Web application)
#   TikTok  : TikTok for Developers -> app with video.publish scope
#   Instagram: Facebook app; the IG account must be Business/Creator on a Page
#   X       : X Developer Portal -> app with Read and Write
# Register this redirect URI with each of them:
#   <SNSAUTO_PUBLIC_BASE_URL>/connect/<platform>/callback

# ============================================================================
# 競合リサーチ（市場分析）
# ============================================================================

# ---- 母集団の絞り込み ----
# 既定は「関連度上位N件」で、YouTube ではこれが古い動画に偏ります。
# 「今何が効いているか」を知りたい場合は期間を切ってください。
SNSAUTO_RESEARCH_WITHIN_DAYS=
# short(〜4分) | medium(4〜20分) | long(20分〜)  ※YouTubeのみ有効
SNSAUTO_RESEARCH_DURATION=
# relevance | date | views
SNSAUTO_RESEARCH_ORDER=relevance

# ---- 除外フィルタ ----
# 自社アカウントを必ず入れてください。入れないと、比較対象の母集団に自分が
# 含まれ、投稿するたびにベンチマークが動きます。カンマ区切り。
SNSAUTO_RESEARCH_EXCLUDE_AUTHORS=
# タイトル・キャプションに対する正規表現（広告投稿の除外など）
SNSAUTO_RESEARCH_EXCLUDE_PATTERN=
SNSAUTO_RESEARCH_MIN_VIEWS=0

# ---- テロップ解析（画面内の文字を読む） ----
# auto      : tesseract があれば使い、ANTHROPIC_API_KEY があれば装飾も読む（既定）
# tesseract : OCRのみ
# vision    : Claude のみ（フレームごとにAPI呼び出しが発生します）
# off       : 画面内テロップを読まない
SNSAUTO_TELOP_READER=auto
SNSAUTO_TELOP_INTERVAL=0.8
SNSAUTO_TELOP_MAX_FRAMES=45
SNSAUTO_TELOP_VISION_BUDGET=6
# 日本語OCRには tesseract の jpn 言語データが必要です:
#   apt-get install tesseract-ocr tesseract-ocr-jpn

# ---- 競合動画の取得 ----
# Instagram は公式APIが media_url を返すため、そのまま取得できます（規約内）。
# それ以外のプラットフォームで動画を取得するには、外部ダウンローダを明示的に
# 設定する必要があります。**既定では無効です。**
#
#   競合の動画をダウンロードしてよいかは各プラットフォームの利用規約の問題で、
#   その判断は運用者が行うものです。このツールは既定では行いません。
#   設定した場合、取得元はレポートに「外部ダウンローダーで取得」と明記されます。
#
# テンプレートには {url} と {out} を使います。シェルは経由しません。
#   例: SNSAUTO_VIDEO_FETCH_CMD=yt-dlp -f mp4 -o {out} {url}
SNSAUTO_VIDEO_FETCH_CMD=
SNSAUTO_VIDEO_FETCH_TIMEOUT=300

# ---- コメント本文の取得 ----
# YouTube: APIキーのみで取得可 / X: 直近7日のリプライ
# Instagram: 自社投稿のみ（競合のコメントは公式APIで取得不可）
SNSAUTO_COMMENT_LIMIT=50
