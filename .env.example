# ---- Core ----
SNSAUTO_DB_URL=sqlite:///workspace/snsauto.db
SNSAUTO_WORKSPACE=workspace

# ---- LLM (script / storyboard / analysis) ----
ANTHROPIC_API_KEY=
SNSAUTO_LLM_MODEL=claude-opus-5

# ---- YouTube Data API v3 ----
# Research (search/statistics) needs only an API key.
YOUTUBE_API_KEY=
# Upload needs OAuth2 (user consent, youtube.upload scope).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- X (Twitter) API v2 ----
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- Instagram Graph API (Business/Creator account via Facebook app) ----
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- TikTok Content Posting API ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- Image generation (optional; provider-agnostic HTTP endpoint) ----
IMAGEGEN_PROVIDER=placeholder
IMAGEGEN_API_KEY=
IMAGEGEN_ENDPOINT=
