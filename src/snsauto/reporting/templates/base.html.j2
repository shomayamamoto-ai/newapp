<!doctype html>
<html lang="{{ lang | default('ja') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ title | default('SNS Report') }}{% endblock %}</title>
<style>
:root{
  --ink:#14161c; --ink-2:#4a5163; --ink-3:#7b8497;
  --bg:#ffffff; --bg-2:#f6f7fa; --line:#e3e6ee;
  --brand:{{ brand_color | default('#3b5bdb') }};
  --good:#2b8a3e; --warn:#b8860b; --bad:#c92a2a;
  --radius:10px;
  --font: {{ font_stack | default("'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif") }};
}
*{box-sizing:border-box}
body{margin:0;font-family:var(--font);color:var(--ink);background:var(--bg);
     font-size:13px;line-height:1.65;-webkit-font-smoothing:antialiased}
.page{max-width:900px;margin:0 auto;padding:32px 28px 56px}
header.masthead{border-bottom:3px solid var(--brand);padding-bottom:14px;margin-bottom:26px}
.eyebrow{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
         color:var(--brand);font-weight:700;margin:0 0 4px}
h1{font-size:24px;margin:0 0 6px;letter-spacing:-.01em;line-height:1.25}
h2{font-size:15px;margin:30px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--line)}
h3{font-size:12.5px;margin:18px 0 8px;color:var(--ink-2)}
.sub{color:var(--ink-3);font-size:11.5px;margin:0}
.grid{display:grid;gap:10px}
.grid-4{grid-template-columns:repeat(4,1fr)}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-2{grid-template-columns:repeat(2,1fr)}
.card{background:var(--bg-2);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px}
.stat{font-size:21px;font-weight:700;letter-spacing:-.02em;line-height:1.2}
.stat-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);
            font-weight:600;margin-bottom:3px}
.stat-note{font-size:10.5px;color:var(--ink-3);margin-top:2px}
table{width:100%;border-collapse:collapse;font-size:11.5px;margin:8px 0}
th{text-align:left;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;
   color:var(--ink-3);border-bottom:1.5px solid var(--line);padding:6px 8px;font-weight:700}
td{padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
tbody tr:nth-child(even){background:var(--bg-2)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
.rank{color:var(--ink-3);font-weight:700;width:26px}
.trunc{max-width:290px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tag{display:inline-block;background:var(--bg-2);border:1px solid var(--line);
     border-radius:999px;padding:1.5px 9px;font-size:10.5px;margin:0 3px 4px 0;color:var(--ink-2)}
.pill{display:inline-block;border-radius:999px;padding:2px 10px;font-size:10px;
      font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.pill.success{background:#e7f5eb;color:var(--good)}
.pill.partial{background:#fdf5e2;color:var(--warn)}
.pill.failure{background:#fdeaea;color:var(--bad)}
.pill.inconclusive{background:var(--bg-2);color:var(--ink-3)}
.bar{height:5px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:5px}
.bar>span{display:block;height:100%;background:var(--brand)}
.note{background:var(--bg-2);border-left:3px solid var(--brand);padding:10px 14px;
      border-radius:0 var(--radius) var(--radius) 0;margin:12px 0;font-size:11.5px}
.empty{color:var(--ink-3);font-style:italic;padding:14px 0;font-size:11.5px}
footer{margin-top:36px;padding-top:12px;border-top:1px solid var(--line);
       color:var(--ink-3);font-size:10px;display:flex;justify-content:space-between}
ul.tight{margin:6px 0;padding-left:18px}
ul.tight li{margin-bottom:4px}
@page{size:A4;margin:14mm}
@media print{
  body{font-size:10.5pt}
  .page{padding:0;max-width:none}
  h2{break-after:avoid}
  table{break-inside:auto}
  tr{break-inside:avoid}
  .card{break-inside:avoid}
}
{% block extra_css %}{% endblock %}
</style>
</head>
<body>
<div class="page">
  <header class="masthead">
    <p class="eyebrow">{% block eyebrow %}SNS Autopilot{% endblock %}</p>
    <h1>{% block heading %}{{ title | default('Report') }}{% endblock %}</h1>
    <p class="sub">{% block subheading %}{{ project.name if project else '' }}{% endblock %}</p>
  </header>
  {% block content %}{% endblock %}
  <footer>
    <span>{{ project.name if project else 'SNS Autopilot' }}</span>
    <span>Generated {{ generated_at | dt }} UTC</span>
  </footer>
</div>
</body>
</html>
