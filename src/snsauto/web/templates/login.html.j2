<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ログイン · snsauto</title>
<style>
:root{--bg:#f7f8fa;--panel:#fff;--panel-2:#f1f3f7;--line:#e2e6ee;--ink:#151821;
      --ink-2:#4d5568;--ink-3:#828b9e;--brand:#3b5bdb;--bad:#c92a2a;
      --font:'Helvetica Neue',Arial,'Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0f1116;--panel:#171a21;--panel-2:#1e222b;--line:#2a2f3a;--ink:#e8eaf0;
  --ink-2:#a8b0c0;--ink-3:#767e90;--brand:#748ffc;--bad:#ff6b6b}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);
     display:grid;place-items:center;min-height:100vh;font-size:14px}
.box{background:var(--panel);border:1px solid var(--line);border-radius:12px;
     padding:30px 28px;width:min(360px,92vw)}
.brand{display:flex;align-items:center;gap:8px;font-weight:800;font-size:16px;margin-bottom:2px}
.brand .dot{width:9px;height:9px;border-radius:50%;background:var(--brand)}
p.sub{color:var(--ink-3);font-size:11.5px;margin:0 0 22px 17px}
label{display:block;font-size:11px;font-weight:700;letter-spacing:.06em;
      text-transform:uppercase;color:var(--ink-3);margin-bottom:5px}
input{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:7px;
      background:var(--panel-2);color:var(--ink);font-size:13.5px;font-family:var(--font);margin-bottom:14px}
input:focus{outline:2px solid var(--brand);outline-offset:1px;border-color:transparent}
button{width:100%;background:var(--brand);color:#fff;border:0;border-radius:7px;
       padding:10px;font-size:13.5px;font-weight:700;cursor:pointer;font-family:var(--font)}
button:hover{opacity:.92}
.err{background:color-mix(in srgb,var(--bad) 12%,transparent);color:var(--bad);
     border-radius:7px;padding:9px 12px;font-size:12px;margin-bottom:16px}
</style>
</head>
<body>
<form class="box" method="post" action="/login">
  <div class="brand"><span class="dot"></span>snsauto</div>
  <p class="sub">SNS運用自動化</p>
  {% if error %}<div class="err">{{ error }}</div>{% endif %}
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <label for="email">メールアドレス</label>
  <input id="email" name="email" type="email" autocomplete="username" required autofocus>
  <label for="password">パスワード</label>
  <input id="password" name="password" type="password" autocomplete="current-password" required>
  <button type="submit">ログイン</button>
</form>
</body>
</html>
