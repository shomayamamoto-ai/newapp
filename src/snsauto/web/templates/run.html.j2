{% extends "layout.html.j2" %}
{% block crumb %}<div class="crumb"><a href="/">ダッシュボード</a> / <a href="/projects/{{ project.id }}">{{ project.name }}</a> / 調査</div>{% endblock %}
{% block heading %}「{{ run.keyword }}」{{ run.platform.value | upper }} 上位{{ summary.count }}件{% endblock %}
{% block subheading %}{{ run.created_at | dt }} 取得 ・ source: {{ run.source }}{% endblock %}
{% block actions %}<a class="btn ghost" href="/runs/{{ run.id }}/report">レポート</a>{% endblock %}

{% block content %}
{% if summary.count == 0 %}
<p class="empty">この調査には投稿がありません。</p>
{% else %}
<div class="grid g4">
  <div class="card"><div class="stat-label">分析件数</div><div class="stat">{{ summary.count }}</div></div>
  <div class="card"><div class="stat-label">{{ 'エンゲージ率 中央値' if summary.engagement_is_rate else 'インタラクション 中央値' }}</div>
    <div class="stat">{{ summary.engagement.median | pct if summary.engagement_is_rate else summary.engagement.median | int_ }}</div>
    <div class="stat-note">四分位 {{ summary.engagement.p25 | pct if summary.engagement_is_rate else summary.engagement.p25 | int_ }}〜{{ summary.engagement.p75 | pct if summary.engagement_is_rate else summary.engagement.p75 | int_ }}</div></div>
  <div class="card"><div class="stat-label">勝ちパターンの尺</div>
    <div class="stat">{{ summary.duration_sec.band_top or 'ばらつき' }}</div>
    <div class="stat-note">{% if summary.duration_sec.spread_top %}上位 {{ summary.duration_sec.spread_top.p25 | dur }}〜{{ summary.duration_sec.spread_top.p75 | dur }}{% else %}-{% endif %}</div></div>
  <div class="card"><div class="stat-label">伸びている投稿時刻</div>
    <div class="stat">{% if summary.timing.usable %}{% for e in summary.timing.best %}{{ e.bucket }}{% if summary.timing.grain == 'hour' %}時{% endif %}{% if not loop.last %}·{% endif %}{% endfor %}{% else %}判定不能{% endif %}</div>
    <div class="stat-note">{{ summary.timing.timezone }}</div></div>
</div>

{% if summary.reliability in ('insufficient', 'weak') or not summary.engagement_is_rate or (summary.timing and not summary.timing.usable) %}
<div class="note warn">
  <strong>この数字の読み方</strong>
  <ul class="tight">
    {% if summary.reliability in ('insufficient', 'weak') %}
    <li>{{ summary.count }}件は{{ RELIABILITY_JA.get(summary.reliability, summary.reliability) }}。中央値や四分位はこの件数では傾向とばらつきを分けきれません。</li>
    {% endif %}
    {% if not summary.engagement_is_rate %}
    <li>{{ summary.engagement_basis_label }}。<b>他プラットフォームの調査結果とは比較できません。</b></li>
    {% endif %}
    {% if summary.timing and not summary.timing.usable %}
    <li>{{ summary.timing.reason }}</li>
    {% endif %}
  </ul>
</div>
{% endif %}

{% if run.filters %}
<div class="note">
  <strong>この母集団について</strong>
  <ul class="tight">
    <li>{{ run.filters.collected or summary.count }}件取得 → {{ run.filters.kept or summary.count }}件を採用
      {%- if run.filters.dropped %}（除外: {% for reason, n in run.filters.dropped.items() %}{{ EXCLUSION_JA.get(reason, reason) }} {{ n }}件{% if not loop.last %} / {% endif %}{% endfor %}）{% endif %}</li>
    {% if run.filters.applied %}<li>適用したフィルタ: {% for key, value in run.filters.applied.items() %}{{ FILTER_JA.get(key, key) }}={{ value }}{% if not loop.last %} / {% endif %}{% endfor %}</li>{% endif %}
    {% if run.filters.ignored %}<li class="warn">{{ run.platform.value | upper }} が受け付けなかった条件: {% for key, value in run.filters.ignored.items() %}{{ FILTER_JA.get(key, key) }}={{ value }}{% if not loop.last %} / {% endif %}{% endfor %}
      <span class="sub">— このAPIでは指定できないため、結果には反映されていません。</span></li>{% endif %}
    {% if run.filters.watch %}<li>定点ウォッチ: @{{ run.filters.watch.handle }}
      {%- if run.filters.watch.followers %} ・ フォロワー {{ run.filters.watch.followers | int_ }}{% endif %}</li>{% endif %}
  </ul>
</div>
{% endif %}

<h2>上位パフォーマー</h2>
<p class="sub" style="margin-bottom:8px">エンゲージ率{{ weights.engagement | pct(0) }}・伸び速度{{ weights.velocity | pct(0) }}・到達{{ weights.reach | pct(0) }}の合成スコア順。再生数順ではありません。</p>
<table>
  <thead><tr><th class="rank">#</th><th>タイトル</th><th class="num">再生</th>
             <th class="num">エンゲージ</th><th class="num">スコア</th><th class="num">尺</th><th>フック</th></tr></thead>
  <tbody>
  {% for post in posts %}
    <tr>
      <td class="rank">{{ post.rank }}</td>
      <td><div class="trunc">{% if post.url %}<a href="{{ post.url }}" target="_blank" rel="noopener">{{ post.title or post.external_id }}</a>{% else %}{{ post.title or post.external_id }}{% endif %}</div></td>
      <td class="num">{{ post.views | int_ }}</td>
      <td class="num">{{ post.engagement_rate | pct }}</td>
      <td class="num">{{ '%.3f' | format(post.score) }}</td>
      <td class="num">{{ post.duration_sec | dur }}</td>
      <td>{% if post.structure %}<span class="pill mute">{{ post.structure.hook_type }}</span>{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if hook_distribution %}
<h2>フック類型</h2>
<table>
  <thead><tr><th>類型</th><th class="num">件数</th><th>比率</th></tr></thead>
  <tbody>
  {% for name, count in hook_distribution %}
    <tr><td>{{ name }}</td><td class="num">{{ count }}</td>
        <td><div class="bar"><span style="width:{{ (count / analysed * 100) | round(1) }}%"></span></div></td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="sub">上位{{ analysed }}件を構成分析した結果</p>
{% endif %}

{% if summary.timing and summary.timing.usable %}
<h2>投稿時刻とパフォーマンス</h2>
<p class="sub" style="margin-bottom:8px">{{ summary.timing.note }}</p>
<table>
  <thead><tr><th>{{ '時刻' if summary.timing.grain == 'hour' else '時間帯' }}（{{ summary.timing.timezone }}）</th>
             <th class="num">件数</th><th class="num">エンゲージ中央値</th><th>全体中央値との差</th></tr></thead>
  <tbody>
  {% for entry in (summary.timing.by_hour if summary.timing.grain == 'hour' else summary.timing.by_daypart)['all'][:8] %}
    <tr>
      <td>{{ entry.bucket }}{% if summary.timing.grain == 'hour' %}時{% endif %}
          {%- if entry.above_median %} <span class="pill ok">上位</span>{% endif %}</td>
      <td class="num">{{ entry.posts }}</td>
      <td class="num">{{ entry.median_engagement | pct if summary.engagement_is_rate else entry.median_engagement | int_ }}</td>
      <td class="num">{{ '%+.0f' | format(entry.lift_vs_median * 100) ~ '%' if entry.lift_vs_median is number else '-' }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% if (summary.timing.by_hour if summary.timing.grain == 'hour' else summary.timing.by_daypart)['thin'] %}
<p class="sub">件数が足りず判定対象外: {% for e in (summary.timing.by_hour if summary.timing.grain == 'hour' else summary.timing.by_daypart)['thin'][:6] %}{{ e.bucket }}{% if summary.timing.grain == 'hour' %}時{% endif %}({{ e.posts }}){% if not loop.last %} / {% endif %}{% endfor %}</p>
{% endif %}
{% endif %}

<div class="grid g2">
  <div><h2>頻出ハッシュタグ</h2>
    {% for tag, count in summary.top_hashtags %}<span class="tag">#{{ tag }} <strong>{{ count }}</strong></span>
    {% else %}<p class="sub">なし</p>{% endfor %}</div>
  <div><h2>上位投稿の頻出語</h2>
    {% for word, count in summary.winning_words %}<span class="tag">{{ word }} <strong>{{ count }}</strong></span>
    {% else %}<p class="sub">なし</p>{% endfor %}</div>
</div>

{% if telop_posts %}
<h2>画面内テロップ（実測）</h2>
<p class="sub" style="margin-bottom:8px">動画から実際に読み取った文字です。キャプションの統計ではありません。</p>
{% for row in telop_posts %}
<div class="card" style="margin-bottom:10px">
  <div class="spread">
    <strong class="trunc">{% if row.post.url %}<a href="{{ row.post.url }}" target="_blank" rel="noopener">{{ row.post.title or row.post.external_id }}</a>{% else %}{{ row.post.title or row.post.external_id }}{% endif %}</strong>
    <span class="pill {{ 'ok' if row.band == 'high' else ('mute' if row.band == 'medium' else 'warn') }}">OCR信頼度 {{ BAND_JA.get(row.band, row.band) }}</span>
  </div>
  <div class="grid g4" style="margin:10px 0">
    <div><div class="stat-label">テロップ枚数</div><div class="stat">{{ row.telop.event_count }}</div></div>
    <div><div class="stat-label">画面占有率</div><div class="stat">{{ (row.telop.coverage_ratio * 100) | round(0) | int }}%</div></div>
    <div><div class="stat-label">1枚あたり</div><div class="stat">{{ row.telop.avg_chars }}字</div>
      <div class="stat-note">{{ row.telop.avg_hold_sec or '-' }}秒表示</div></div>
    <div><div class="stat-label">初回表示</div><div class="stat">{{ row.telop.first_telop_sec }}秒</div></div>
  </div>
  {% if row.telop.events %}
  <table>
    <thead><tr><th class="num">時刻</th><th>テロップ</th><th>位置</th></tr></thead>
    <tbody>
    {% for event in row.telop.events[:8] %}
      <tr><td class="num">{{ event.start }}s</td>
          <td class="trunc">{{ event.text | replace('\n', ' ') }}</td>
          <td><span class="pill mute">{{ POSITION_JA.get(event.position, event.position) }}</span></td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if row.pacing %}<p class="sub">編集: {{ row.pacing.cut_count }}カット / 平均{{ row.pacing.avg_shot_sec }}秒</p>{% endif %}
  {% if row.audio and row.audio.has_audio %}<p class="sub">音声: {{ AUDIO_JA.get(row.audio.audio_style, row.audio.audio_style) }}（無音 {{ (row.audio.silence_ratio * 100) | round(0) | int }}%）</p>{% endif %}
  {% if row.provenance %}<p class="sub">取得元: {{ row.provenance }}</p>{% endif %}
</div>
{% endfor %}
{% elif telop_unavailable %}
<h2>画面内テロップ</h2>
<div class="note"><strong>未測定です。</strong>
  <p class="sub">{{ telop_unavailable }}</p></div>
{% endif %}

{% if comment_summary and comment_summary.count %}
<h2>視聴者が聞いていること</h2>
<p class="sub" style="margin-bottom:8px">{{ comment_summary.count }}件のコメントのうち{{ (comment_summary.question_share * 100) | round(0) | int }}%が質問。いいね数順＝同じ疑問を持つ人の多さ順です。</p>
<table>
  <thead><tr><th class="num">いいね</th><th>コメント</th></tr></thead>
  <tbody>
  {% for row in comment_summary.top_questions %}
    <tr><td class="num">{{ row.likes }}</td><td><div class="trunc">{{ row.text }}</div></td></tr>
  {% endfor %}
  </tbody>
</table>
{% if comment_summary.unmet_needs %}
<h3>要望・不満</h3>
{% for row in comment_summary.unmet_needs %}<div class="sub">・{{ row.text }}（{{ row.likes }}）</div>{% endfor %}
{% endif %}
{% if comment_summary.recurring_terms %}
<h3>繰り返し出てくる語</h3>
{% for word, count in comment_summary.recurring_terms %}<span class="tag">{{ word }} <strong>{{ count }}</strong></span>{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endblock %}
