[Unit]
Description=snsauto web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=snsauto
Group=snsauto
WorkingDirectory=/opt/snsauto
EnvironmentFile=/opt/snsauto/.env
# データは ReadWritePaths の中に置く。ProtectSystem=strict のため、それ以外は
# 読み取り専用で、相対パスの既定値（/opt/snsauto/workspace）には書けない。
# EnvironmentFile の値はここを上書きするので、.env ではこの2つを設定しないこと。
# web と worker で同じ値でなければ、予約投稿が別のDBに入って投稿されない。
Environment=SNSAUTO_DB_URL=sqlite:////opt/snsauto/data/snsauto.db
Environment=SNSAUTO_WORKSPACE=/opt/snsauto/data/workspace
# Bind to loopback only; Nginx terminates TLS and proxies to it. Exposing
# uvicorn directly would serve the UI over plain HTTP.
ExecStart=/opt/snsauto/.venv/bin/snsauto serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# The app only ever writes to its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/snsauto/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
